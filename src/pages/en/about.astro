---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
---
<Layout title="About López Márquez Abogados | Barcelona" description="Learn how López Márquez Abogados works with individuals and businesses from its Barcelona office, in person and online across Spain.">
<PageHero eyebrow="About the firm" title="A Barcelona law firm where you can explain the problem in your own words." description="We start with the facts, documents and dates that can change the analysis, then explain which options need to be considered." primaryLabel="Contact the firm" primaryHref="/en/contact" secondaryLabel="Our main services" secondaryHref="/en" note="Barcelona · Spain · In person and online" />
<section class="section"><div class="container split"><div><span class="eyebrow">How we work</span><h2>Understand. Check. Act.</h2></div><div class="prose"><div class="method-list"><div><span class="number">01</span><div><h3>Understand</h3><p>What happened, what you need and what outcome matters to you.</p></div></div><div><span class="number">02</span><div><h3>Check</h3><p>Documents, dates, legal route and the facts that can change the case.</p></div></div><div><span class="number">03</span><div><h3>Act</h3><p>Advice on the next step: negotiate, apply, claim, defend or prepare a legal action.</p></div></div></div></div></div></section>
<section class="section section-paper"><div class="container cards"><a class="card" href="/en/employment"><div><span class="card-kicker">Employment</span><h3>Employment law in Barcelona and Spain</h3><p>Dismissals, severance, salary claims, workplace issues and company advice.</p></div><span class="link-arrow">Employment services →</span></a><a class="card" href="/en/immigration"><div><span class="card-kicker">Immigration</span><h3>Immigration law for international clients</h3><p>Residence, nationality, family reunification and regularisation.</p></div><span class="link-arrow">Immigration services →</span></a><a class="card" href="/en/business"><div><span class="card-kicker">Business</span><h3>Preventive employment advice</h3><p>Support for companies before sensitive decisions become disputes.</p></div><span class="link-arrow">Business services →</span></a></div></section>
<CTA title="Need to talk through a legal issue?" text="Start with what happened and the date that matters." label="Contact the firm" />
</Layout>
<style>.method-list{display:grid;gap:20px}.method-list>div{display:grid;grid-template-columns:42px 1fr;gap:16px;align-items:start}.method-list h3{margin:0 0 5px}.method-list p{margin:0}.method-list .number{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--line);border-radius:50%;font-size:.75rem;color:var(--muted)}</style>
