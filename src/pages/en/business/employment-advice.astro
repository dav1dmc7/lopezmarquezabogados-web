import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTA from '../../../components/CTA.astro';
---
<Layout title="Employment Advice for Companies | Barcelona, Spain" description="Preventive employment law advice for companies in Barcelona and Spain. Review contracts, disciplinary measures, dismissals, workplace disputes and employment decisions.">
<PageHero eyebrow="Company employment advice" title="Check the employment decision before it leaves the meeting room." description="The most useful review often happens before the decision is communicated: facts, documentation, procedure, timing and the business objective all need to line up." primaryLabel="Discuss the decision" primaryHref="/en/contact" secondaryLabel="Company review tool" secondaryHref="/en/business#autodiagnostico-empresa" />
<section class="section"><div class="container split"><div><span class="eyebrow">Typical questions</span><h2>Where preventive employment advice adds value.</h2></div><div class="prose"><ul><li>Hiring, contract changes and employment documentation.</li><li>Disciplinary decisions and internal conflicts.</li><li>Dismissals and other employment exits.</li><li>Workplace disputes and sensitive employee communications.</li><li>Recurring questions where the company needs a consistent legal channel.</li></ul><p>The aim is not to add paperwork for its own sake. It is to identify which legal and documentary points need to be checked before a decision is implemented.</p></div></div></section>
<section class="section"><div class="container prose"><h2>Permanent disability and continuity of employment</h2><p>When a worker is recognised as having total, absolute or severe permanent incapacity, the company should review the current legal framework before treating the contract as terminated. Law 2/2025 requires the relevant adjustment or alternative-post options to be considered under the statutory conditions.</p><p><a href="/en/employment/permanent-disability">See the permanent disability guide →</a></p></div></section>
<section class="section section-paper"><div class="container cards"><div class="card"><div><span class="card-kicker">Facts</span><h3>What actually happened?</h3><p>Separate the documented facts from assumptions before drafting the next communication.</p></div></div><div class="card"><div><span class="card-kicker">Process</span><h3>What process applies?</h3><p>Check the contractual, collective and statutory framework relevant to the decision.</p></div></div><div class="card"><div><span class="card-kicker">Timing</span><h3>When does it have to happen?</h3><p>Identify dates, notice requirements and any procedural window before communicating the decision.</p></div></div></div></section>
<CTA title="Need to review a company decision?" text="Send us the essential facts, the timing and the documents already prepared." label="Contact the firm" />
</Layout>
