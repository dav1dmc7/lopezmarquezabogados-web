---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import IndemnizacionCalculator from '../../components/IndemnizacionCalculator.astro';
---
<Layout title="Dismissal Severance Lawyer in Barcelona | Spain" description="Review dismissal severance and compensation in Barcelona and Spain. Check service length, salary, termination type and the documents behind the figure offered by your employer.">
<PageHero eyebrow="Severance" title="Is the dismissal compensation figure correct? Start with the underlying facts." description="Length of service, salary composition, the type of termination and the documents delivered by the employer can all matter. This page helps you prepare the first review." primaryLabel="Review my case" primaryHref="/en/contact" secondaryLabel="Dismissal guidance" secondaryHref="/en/employment-dismissal" />
<section class="section"><div class="container split"><div><span class="eyebrow">What to check</span><h2>The number alone does not tell the whole story.</h2></div><div class="prose"><h3>Length of service</h3><p>Check the actual start date and any relevant employment periods that need to be considered.</p><h3>Salary used for the calculation</h3><p>Depending on the circumstances, salary components, variable pay and other remuneration may need to be reviewed.</p><h3>Type of termination</h3><p>The applicable regime depends on how the employment relationship ended. Compensation and legal classification are distinct questions.</p><h3>Settlement and compensation</h3><p>The final settlement may include salary, accrued holiday or other amounts in addition to compensation.</p></div></div></section>
<IndemnizacionCalculator lang="en" />
<CTA title="Does the amount you were offered look wrong?" text="Send the essential documents and figures so the underlying calculation can be reviewed." label="Contact the firm" />
</Layout>
