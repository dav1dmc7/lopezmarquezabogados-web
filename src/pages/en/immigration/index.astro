---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTA from '../../../components/CTA.astro';
import ExtranjeriaTriage from '../../../components/ExtranjeriaTriage.astro';
---
<Layout title="Immigration Lawyer in Barcelona | Spain" description="Immigration lawyer in Barcelona for residence, Spanish nationality, family reunification and regularisation in Spain. English-language enquiries welcome.">
<PageHero eyebrow="Immigration" title="Immigration lawyer in Barcelona: start with the route that fits your situation." description="We help international clients identify the relevant immigration route in Spain, organise the evidence and understand the next step." primaryLabel="Discuss my situation" primaryHref="/en/contact" secondaryLabel="Find my route" secondaryHref="#triaje-extranjeria" note="Barcelona · Spain · In person and online" />
<section class="section section-paper"><div class="container cards"><a class="card card-featured" href="/en/immigration/residency"><div><span class="card-kicker">Residence</span><h2>Residence in Spain</h2><p>First identify whether you need a first permit, renewal, modification or another route.</p></div><span class="link-arrow">Spain residence lawyer →</span></a><a class="card" href="/en/immigration/spanish-nationality"><div><span class="card-kicker">Nationality</span><h2>Spanish nationality</h2><p>Review residence history, eligibility and the evidence that supports the application.</p></div><span class="link-arrow">Spanish nationality lawyer →</span></a><a class="card" href="/en/immigration/family-reunification"><div><span class="card-kicker">Family</span><h2>Family reunification</h2><p>Understand the family relationship, the status of the person in Spain and the relevant route.</p></div><span class="link-arrow">Family reunification in Spain →</span></a><a class="card" href="/en/immigration/regularisation"><div><span class="card-kicker">Regularisation</span><h2>Arraigo and regularisation</h2><p>Review whether the route linked to your time in Spain and circumstances may fit.</p></div><span class="link-arrow">Regularisation guidance →</span></a></div></section>
<ExtranjeriaTriage />
<section class="section"><div class="container split"><div><span class="eyebrow">What changes the route</span><h2>Your current status matters as much as the documents.</h2></div><div class="prose"><ul><li>Whether you are in Spain or abroad.</li><li>Your current or previous immigration status.</li><li>Your nationality and family circumstances.</li><li>Your employment, professional or financial situation where relevant.</li><li>Existing applications, refusals, notifications or deadlines.</li></ul><p><a href="/en/contact">Tell us the essential facts →</a></p></div></div></section>
<CTA title="Not sure which immigration route applies?" text="Start with where you are, your current status and what you are trying to achieve." label="Contact the firm" />
</Layout>
