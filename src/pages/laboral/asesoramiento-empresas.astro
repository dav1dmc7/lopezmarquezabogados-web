---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
---
<Layout title="Asesoramiento laboral para empresas" description="Asesoramiento jurídico laboral preventivo para empresas y PYMES: contratación, conflictos, medidas disciplinarias y extinción de contratos.">
<PageHero eyebrow="Empresas" title="Prevención laboral para decidir antes del conflicto." description="Un buen asesoramiento no consiste en redactar más documentos: consiste en detectar riesgos, ordenar decisiones y dejar constancia de lo que se ha hecho." />
<section class="section section-paper"><div class="container cards"><div class="card"><div><span class="card-kicker">Contratación</span><h3>Contratos y cambios</h3><p>Revisión de estructuras contractuales y decisiones laborales relevantes.</p></div></div><div class="card"><div><span class="card-kicker">Conflictos</span><h3>Medidas disciplinarias</h3><p>Valoración previa de hechos, documentación y proporcionalidad.</p></div></div><div class="card"><div><span class="card-kicker">Extinción</span><h3>Despidos y salidas</h3><p>Preparación y revisión de decisiones con atención a procedimiento y riesgo.</p></div></div></div></section>
<CTA title="Tu empresa necesita un criterio laboral disponible" text="Consulta el modelo de asesoramiento recurrente del despacho." label="Ver asesoramiento para empresas" href="/empresas/iguala-laboral" />
</Layout>
