---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import IndemnizacionCalculator from '../../components/IndemnizacionCalculator.astro';
import PrepareConsultation from '../../components/PrepareConsultation.astro';
---
<Layout title="Indemnización por despido: cálculo y revisión | Barcelona" description="Calcula una estimación de indemnización por despido y descubre qué documentos y datos hay que revisar para saber si la cifra encaja con tu caso.">
<PageHero eyebrow="Indemnización por despido" title="Haz una primera estimación. Después comprobamos si la cifra encaja con tu caso." description="La cantidad depende de la antigüedad, el salario regulador, el tipo de despido y las circunstancias del contrato. La calculadora solo sirve como punto de partida." primaryLabel="Calcular indemnización" primaryHref="#calculadora-titulo" secondaryLabel="Quiero revisar mi despido" secondaryHref="/contacto" note="La herramienta no determina si un despido es procedente o improcedente." />
<IndemnizacionCalculator />
<section class="section"><div class="container split"><div><span class="eyebrow">Qué hay que comprobar</span><h2>Una cifra puede parecer correcta y no contar toda la historia.</h2></div><div class="prose"><h3>Antigüedad</h3><p>La fecha de inicio y los periodos que realmente computan son esenciales.</p><h3>Salario regulador</h3><p>El cálculo puede requerir revisar conceptos retributivos, variables, pagas extraordinarias y otras partidas según el caso.</p><h3>Tipo de extinción</h3><p>La indemnización depende del régimen jurídico aplicable. Un escenario de 33 días no significa que el despido haya sido declarado improcedente.</p><h3>Finiquito e indemnización</h3><p>Son conceptos distintos. La liquidación final puede incluir salarios, vacaciones u otras cantidades pendientes.</p></div></div></section>
<PrepareConsultation title="Qué conviene tener a mano" intro="Para revisar una propuesta económica, empieza por estos documentos. Si falta alguno, podemos valorar el caso con lo que ya tengas." items={['Carta de despido completa y fecha exacta de notificación.','Contrato y anexos o modificaciones relevantes.','Últimas nóminas y composición retributiva.','Finiquito o propuesta de indemnización entregada por la empresa.']} />
<CTA title="¿La cifra que te han dado no te convence?" text="Envíanos el contexto y te indicaremos qué datos conviene revisar." label="Enviar consulta" />
</Layout>
