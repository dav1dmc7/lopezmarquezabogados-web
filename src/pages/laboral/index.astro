---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
---
<Layout title="Derecho Laboral en Barcelona" description="Asesoramiento y defensa en Derecho Laboral para trabajadores y empresas: despidos, indemnizaciones, salarios, conflictos y accidentes laborales.">
<PageHero eyebrow="Derecho Laboral" title="Derecho Laboral cuando el tiempo y los hechos importan." description="Analizamos el problema laboral desde la documentación y las fechas. Trabajamos con trabajadores y empresas en consultas, negociación y defensa." />
<section class="section section-paper"><div class="container"><div class="cards">
<a class="card" href="/laboral/despidos"><div><span class="card-kicker">Trabajadores</span><h3>Despidos</h3><p>Revisión de carta de despido, procedimiento, plazos, finiquito y vías de impugnación.</p></div><span class="link-arrow">Ver despidos →</span></a>
<a class="card" href="/laboral/indemnizacion-despido"><div><span class="card-kicker">Cálculo</span><h3>Indemnización por despido</h3><p>Qué conceptos debemos revisar y qué documentación hace falta para calcularla correctamente.</p></div><span class="link-arrow">Ver indemnización →</span></a>
<a class="card" href="/laboral/reclamacion-salarios"><div><span class="card-kicker">Reclamaciones</span><h3>Salarios y cantidades</h3><p>Nóminas, diferencias salariales, horas y cantidades pendientes: primero cuantificamos, después actuamos.</p></div><span class="link-arrow">Ver reclamaciones →</span></a>
<a class="card" href="/laboral/accidentes-laborales"><div><span class="card-kicker">Especial</span><h3>Accidentes laborales</h3><p>Revisión del contexto laboral, responsabilidades y posibles vías jurídicas.</p></div><span class="link-arrow">Ver accidentes →</span></a>
<a class="card" href="/laboral/penal-laboral"><div><span class="card-kicker">Situaciones críticas</span><h3>Dimensión penal laboral</h3><p>Valoración de hechos que, además del ámbito laboral, pueden requerir análisis penal.</p></div><span class="link-arrow">Ver dimensión penal →</span></a>
<a class="card" href="/laboral/asesoramiento-empresas"><div><span class="card-kicker">Empresas</span><h3>Asesoramiento laboral</h3><p>Contratos, medidas disciplinarias, despidos y prevención de conflictos laborales.</p></div><span class="link-arrow">Ver asesoramiento →</span></a>
</div></div></section>
<CTA title="¿Te han comunicado un despido?" text="No necesitas contar toda la historia perfecta. Lo importante es conservar la documentación y comprobar las fechas." label="Revisar mi situación" href="/laboral/despidos" />
</Layout>
