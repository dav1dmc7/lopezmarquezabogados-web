---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
---
<Layout title="Asesoramiento laboral para empresas en Barcelona" description="Asesoramiento laboral preventivo para empresas: contratos, medidas disciplinarias, conflictos, despidos y decisiones que conviene revisar antes de ejecutar.">
<PageHero eyebrow="Asesoramiento empresarial" title="¿Tienes que tomar una decisión laboral y quieres revisarla antes?" description="Analizamos la decisión concreta, los hechos que la sostienen y la documentación disponible para detectar qué debe comprobarse antes de ejecutarla." primaryLabel="Consultar una decisión" primaryHref="/contacto" secondaryLabel="Ver iguala laboral" secondaryHref="/empresas/iguala-laboral" />
<section class="section section-paper"><div class="container cards"><div class="card"><div><span class="card-kicker">Contratación</span><h3>Contratos y cambios</h3><p>Revisar condiciones, modificaciones y documentación antes de formalizar una decisión.</p></div></div><div class="card"><div><span class="card-kicker">Disciplina</span><h3>Conflictos y medidas</h3><p>Ordenar hechos, pruebas, comunicaciones y la respuesta que se pretende adoptar.</p></div></div><div class="card"><div><span class="card-kicker">Extinción</span><h3>Despidos y salidas</h3><p>Preparar la decisión y revisar procedimiento, documentación y riesgos jurídicos.</p></div></div></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Cómo se plantea</span><h2>Una consulta útil termina con algo más claro que al principio.</h2></div><div class="prose"><ol><li>Qué decisión se quiere tomar.</li><li>Qué hechos pueden acreditarse.</li><li>Qué documentación existe y qué falta.</li><li>Qué riesgos o alternativas merece la pena analizar.</li><li>Qué paso se va a dar y cómo conviene documentarlo.</li></ol><p><a href="/empresas/iguala-laboral">Cuando estas consultas son recurrentes, podemos estudiar un canal de asesoramiento estable →</a></p></div></div></section>
<CTA title="¿Hay una decisión laboral sobre la mesa?" text="Cuéntanos el contexto y qué necesitas decidir antes de actuar." label="Enviar consulta" />
</Layout>
