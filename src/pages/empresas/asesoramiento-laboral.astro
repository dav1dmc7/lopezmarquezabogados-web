---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
---
<Layout title="Asesoramiento laboral para PYMES" description="Asesoramiento jurídico laboral para PYMES: contratación, organización, conflictos, medidas disciplinarias y extinciones.">
<PageHero eyebrow="Asesoramiento empresarial" title="El abogado laboralista también puede estar antes del problema." description="Revisión de decisiones laborales importantes, documentación y estrategia preventiva para empresas que necesitan un canal jurídico accesible." primaryLabel="Consultar una decisión" primaryHref="/contacto" secondaryLabel="Ver iguala" secondaryHref="/empresas/iguala-laboral" />
<section class="section section-paper"><div class="container cards"><div class="card"><div><span class="card-kicker">Contratación</span><h3>Contratos y cambios</h3><p>Revisión de estructuras contractuales y decisiones laborales relevantes.</p></div></div><div class="card"><div><span class="card-kicker">Conflictos</span><h3>Medidas disciplinarias</h3><p>Valoración previa de hechos, documentación y respuesta.</p></div></div><div class="card"><div><span class="card-kicker">Extinción</span><h3>Despidos y salidas</h3><p>Preparación y revisión de decisiones con atención al procedimiento.</p></div></div></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Cómo encaja</span><h2>La consulta debe acabar en una decisión comprensible.</h2></div><div class="prose"><ol><li>Identificar la decisión que está sobre la mesa.</li><li>Ordenar los hechos y documentos.</li><li>Detectar riesgos y cuestiones que requieren más comprobación.</li><li>Definir el siguiente paso y, cuando proceda, documentarlo.</li></ol><p><a href="/empresas/iguala-laboral">Cuando el volumen de consultas es recurrente, estudiar una iguala puede tener sentido →</a></p></div></div></section>
<CTA title="¿Quieres revisar una decisión laboral antes de tomarla?" text="Cuéntanos el contexto y qué decisión necesita apoyo jurídico." label="Contactar" />
</Layout>
