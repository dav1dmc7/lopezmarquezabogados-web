---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import ExtranjeriaTriage from '../../components/ExtranjeriaTriage.astro';
---
<Layout title="Abogado de Extranjería en Barcelona" description="Asesoramiento en Extranjería en Barcelona: arraigo, residencia, nacionalidad española y reagrupación familiar según la situación personal.">
<PageHero eyebrow="Extranjería" title="¿No sabes qué trámite necesitas? Empieza por tu situación, no por el nombre del trámite." description="La vía adecuada puede cambiar según tu nacionalidad, dónde estás, cuánto tiempo llevas en España, tu situación familiar y la autorización que tengas ahora. Antes de preparar el expediente, revisamos esos datos contigo." primaryLabel="Consultar mi situación" primaryHref="/contacto" secondaryLabel="Usar el orientador" secondaryHref="#triaje-extranjeria" note="La vía correcta depende de los hechos y documentos concretos de cada persona." />
<section class="section section-paper" data-reveal><div class="container"><div class="cards">
<a class="card" href="/extranjeria/arraigo"><div><span class="card-kicker">Estoy en España y quiero regularizarme</span><h3>Arraigo</h3><p>Revisamos la modalidad que puede encajar y los requisitos que deben acreditarse.</p></div><span class="link-arrow">Ver arraigo →</span></a>
<a class="card" href="/extranjeria/nacionalidad-espanola"><div><span class="card-kicker">Quiero solicitar la nacionalidad</span><h3>Nacionalidad española</h3><p>Comprobamos el plazo de residencia y los requisitos del expediente.</p></div><span class="link-arrow">Ver nacionalidad →</span></a>
<a class="card" href="/extranjeria/residencia"><div><span class="card-kicker">Necesito una autorización</span><h3>Residencia</h3><p>Identificamos qué autorización puede corresponder antes de preparar la solicitud.</p></div><span class="link-arrow">Ver residencia →</span></a>
<a class="card" href="/extranjeria/reagrupacion-familiar"><div><span class="card-kicker">Quiero resolver una situación familiar</span><h3>Familia y reagrupación</h3><p>Revisamos el vínculo, la situación de residencia y la documentación necesaria.</p></div><span class="link-arrow">Ver reagrupación →</span></a>
</div></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Antes de presentar</span><h2>Antes de preparar una carpeta de documentos, asegúrate de que estás siguiendo la vía adecuada.</h2></div><div class="prose"><p>Primero conviene comprobar tu nacionalidad, situación actual, permanencia, vínculos familiares y la autorización que tienes o quieres solicitar.</p><p>Cuando cambia la normativa, hay que comprobar el texto vigente y cómo afecta a tu situación concreta.</p><p><a href="/recursos/arraigo-dos-anos-2026">Ver la guía sobre arraigo →</a></p></div></div></section>
<ExtranjeriaTriage />
<CTA title="¿Quieres saber qué vía conviene estudiar?" text="Explícanos tu situación con tus propias palabras. No necesitas acertar el nombre del procedimiento." label="Enviar consulta" />
</Layout>
