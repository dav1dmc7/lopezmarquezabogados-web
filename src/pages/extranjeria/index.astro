---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
---
<Layout title="Abogado de Extranjería en Barcelona" description="Asesoramiento en Extranjería: arraigo, residencia, nacionalidad española por residencia y reagrupación familiar.">
<PageHero eyebrow="Extranjería" title="Extranjería explicada con una ruta clara." description="Cada expediente depende de la situación personal y de la vía administrativa aplicable. Revisamos requisitos, documentación y el estado real del expediente." />
<section class="section section-paper"><div class="container cards"><a class="card" href="/extranjeria/arraigo"><div><span class="card-kicker">2026</span><h3>Arraigo</h3><p>Revisión de permanencia, requisitos específicos y documentación antes de presentar.</p></div><span class="link-arrow">Ver arraigo →</span></a><a class="card" href="/extranjeria/nacionalidad-espanola"><div><span class="card-kicker">Nacionalidad</span><h3>Nacionalidad española por residencia</h3><p>Plazos de residencia, documentación y trámites asociados.</p></div><span class="link-arrow">Ver nacionalidad →</span></a><a class="card" href="/extranjeria/residencia"><div><span class="card-kicker">Residencia</span><h3>Autorizaciones de residencia</h3><p>Consulta inicial sobre la vía aplicable y el expediente documental.</p></div><span class="link-arrow">Ver residencia →</span></a><a class="card" href="/extranjeria/reagrupacion-familiar"><div><span class="card-kicker">Familias</span><h3>Reagrupación familiar</h3><p>Revisión de vínculos, requisitos y documentación del expediente.</p></div><span class="link-arrow">Ver reagrupación →</span></a></div></section>
<CTA title="¿No sabes qué trámite corresponde a tu situación?" text="Cuéntanos tu situación y empezaremos por las preguntas que determinan la vía jurídica." label="Consultar Extranjería" />
</Layout>
