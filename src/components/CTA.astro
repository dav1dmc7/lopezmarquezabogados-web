---
import { site } from '../lib/site';
interface Props { title?: string; text?: string; label?: string; href?: string; }
const { title='¿Quieres hablar de tu caso?', text='Cuéntanos brevemente qué ha ocurrido y qué necesitas resolver.', label='Enviar consulta', href=site.emailHref } = Astro.props;
---
<section class="section tight" data-reveal>
  <div class="container">
    <div class="cta">
      <div><h2>{title}</h2><p>{text}</p></div>
      <div class="hero-actions compact">
        <a class="btn btn-dark" href={href} data-track={href.startsWith('mailto:') ? 'email_click' : undefined}>{label}</a>
      </div>
    </div>
  </div>
</section>
