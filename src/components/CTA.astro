---
import { site } from '../lib/site';
interface Props { title?: string; text?: string; label?: string; href?: string; }
const isEnglish = Astro.url.pathname.startsWith('/en');
const {
  title = isEnglish ? 'Need to discuss your situation?' : '¿Quieres hablar de tu caso?',
  text = isEnglish ? 'Tell us briefly what happened, when it happened and what you need to resolve.' : 'Cuéntanos brevemente qué ha ocurrido, cuándo ha ocurrido y qué necesitas resolver.',
  label = isEnglish ? 'Contact the firm' : 'Enviar consulta',
  href = site.emailHref
} = Astro.props;
---
<section class="section tight" data-reveal>
  <div class="container">
    <div class="cta">
      <div><h2>{title}</h2><p>{text}</p></div>
      <div class="hero-actions compact">
        <a class="btn btn-dark" href={href} data-track={href.startsWith('mailto:') ? 'email_click' : 'cta_click'}>{label}</a>
      </div>
    </div>
  </div>
</section>
