---
import { site } from '../lib/site';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  note?: string;
}

const { eyebrow = 'López Márquez Abogados', title, description, primaryLabel, primaryHref, secondaryLabel, secondaryHref, note } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isEnglish = pathname.startsWith('/en');
const isWorkersDev = Astro.url.hostname.endsWith('.workers.dev');

const parents: Record<string, { href: string; label: string }> = {
  '/laboral/incapacidad-temporal': { href: '/laboral', label: 'Derecho Laboral' },
  '/laboral/incapacidad-permanente': { href: '/laboral', label: 'Derecho Laboral' },
  '/laboral/despidos': { href: '/laboral', label: 'Derecho Laboral' },
  '/laboral/indemnizacion-despido': { href: '/laboral', label: 'Derecho Laboral' },
  '/laboral/reclamacion-salarios': { href: '/laboral', label: 'Derecho Laboral' },
  '/laboral/accidentes-laborales': { href: '/laboral', label: 'Derecho Laboral' },
  '/laboral/penal-laboral': { href: '/laboral', label: 'Derecho Laboral' },
  '/laboral/asesoramiento-empresas': { href: '/laboral', label: 'Derecho Laboral' },
  '/extranjeria/arraigo': { href: '/extranjeria', label: 'Extranjería' },
  '/extranjeria/nacionalidad-espanola': { href: '/extranjeria', label: 'Extranjería' },
  '/extranjeria/residencia': { href: '/extranjeria', label: 'Extranjería' },
  '/extranjeria/reagrupacion-familiar': { href: '/extranjeria', label: 'Extranjería' },
  '/empresas/asesoramiento-laboral': { href: '/empresas', label: 'Empresas' },
  '/empresas/iguala-laboral': { href: '/empresas', label: 'Empresas' },
  '/recursos/despido-20-dias-habiles': { href: '/recursos', label: 'Recursos' },
  '/recursos/arraigo-dos-anos-2026': { href: '/recursos', label: 'Recursos' },
  '/recursos/nacionalidad-espanola-plazos': { href: '/recursos', label: 'Recursos' },
  '/recursos/incapacidad-permanente-ley-2025': { href: '/recursos', label: 'Recursos' },
  '/actualidad/medidas-laborales-ayudas-2026': { href: '/actualidad-juridica', label: 'Actualidad jurídica' },
  '/actualidad/transparencia-condiciones-trabajo-2026': { href: '/actualidad-juridica', label: 'Actualidad jurídica' },
  '/actualidad/reglamento-extranjeria-2026': { href: '/actualidad-juridica', label: 'Actualidad jurídica' },
  '/actualidad/ocupaciones-dificil-cobertura-t3-2026': { href: '/actualidad-juridica', label: 'Actualidad jurídica' },
  '/recursos/primeras-horas-despido': { href: '/recursos', label: 'Recursos' }
};

const englishParents: Record<string, { href: string; label: string }> = {
  '/en/employment/temporary-sickness-leave': { href: '/en/employment', label: 'Employment' },
  '/en/employment/permanent-disability': { href: '/en/employment', label: 'Employment' },
  '/en/employment-dismissal': { href: '/en/employment', label: 'Employment' },
  '/en/employment-severance': { href: '/en/employment', label: 'Employment' },
  '/en/employment-salary-claims': { href: '/en/employment', label: 'Employment' },
  '/en/workplace-accidents': { href: '/en/employment', label: 'Employment' },
  '/en/business/employment-advice': { href: '/en/business', label: 'Business' },
  '/en/immigration/residency': { href: '/en/immigration', label: 'Immigration' },
  '/en/immigration/regularisation': { href: '/en/immigration', label: 'Immigration' },
  '/en/immigration/spanish-nationality': { href: '/en/immigration', label: 'Immigration' },
  '/en/immigration/family-reunification': { href: '/en/immigration', label: 'Immigration' },
  '/en/resources': { href: '/en', label: 'Resources' },
  '/en/resources/first-hours-after-dismissal': { href: '/en/resources', label: 'Resources' },
  '/en/resources/dismissal-deadline-spain': { href: '/en/resources', label: 'Resources' },
  '/en/resources/permanent-disability-employment-2025': { href: '/en/resources', label: 'Resources' },
  '/en/resources/arraigo-two-years-spain': { href: '/en/resources', label: 'Resources' },
  '/en/resources/spanish-nationality-residence-period': { href: '/en/resources', label: 'Resources' },
  '/en/legal-updates': { href: '/en', label: 'Legal updates' },
  '/en/legal-updates/employment-measures-aid-beneficiaries-2026': { href: '/en/legal-updates', label: 'Legal updates' },
  '/en/legal-updates/employment-conditions-transparency-2026': { href: '/en/legal-updates', label: 'Legal updates' },
  '/en/legal-updates/immigration-regulation-amendments-2026': { href: '/en/legal-updates', label: 'Legal updates' },
  '/en/legal-updates/shortage-occupation-catalogue-q3-2026': { href: '/en/legal-updates', label: 'Legal updates' }
};

const breadcrumbLabels: Record<string, string> = {
  '/laboral/despidos':'Despidos','/laboral/incapacidad-temporal':'Incapacidad temporal','/laboral/incapacidad-permanente':'Incapacidad permanente','/laboral/indemnizacion-despido':'Indemnización por despido','/laboral/reclamacion-salarios':'Reclamación de salarios','/laboral/accidentes-laborales':'Accidentes laborales','/laboral/penal-laboral':'Dimensión penal en el trabajo','/laboral/asesoramiento-empresas':'Asesoramiento a empresas',
  '/extranjeria/arraigo':'Arraigo','/extranjeria/nacionalidad-espanola':'Nacionalidad española','/extranjeria/residencia':'Residencia','/extranjeria/reagrupacion-familiar':'Reagrupación familiar','/empresas/asesoramiento-laboral':'Asesoramiento laboral','/empresas/iguala-laboral':'Iguala laboral',
  '/recursos/primeras-horas-despido':'Primeras horas tras un despido','/recursos/despido-20-dias-habiles':'20 días hábiles','/recursos/arraigo-dos-anos-2026':'Arraigo en 2026','/recursos/nacionalidad-espanola-plazos':'Plazos de nacionalidad','/recursos/incapacidad-permanente-ley-2025':'Incapacidad permanente','/actualidad-juridica':'Actualidad jurídica',
  '/en/employment/temporary-sickness-leave':'Temporary sickness leave','/en/employment/permanent-disability':'Permanent disability','/en/employment-dismissal':'Dismissal','/en/employment-severance':'Severance','/en/employment-salary-claims':'Salary claims','/en/workplace-accidents':'Workplace accidents','/en/business/employment-advice':'Employment advice','/en/immigration/residency':'Residency','/en/immigration/regularisation':'Regularisation','/en/immigration/spanish-nationality':'Spanish nationality','/en/immigration/family-reunification':'Family reunification','/en/resources/first-hours-after-dismissal':'First hours after dismissal','/en/resources/dismissal-deadline-spain':'Dismissal deadline','/en/resources/permanent-disability-employment-2025':'Permanent disability','/en/resources/arraigo-two-years-spain':'Arraigo in Spain','/en/resources/spanish-nationality-residence-period':'Nationality residence period','/en/legal-updates':'Legal updates'
};

const parent = isEnglish ? englishParents[pathname] : parents[pathname];
const breadcrumbItems = [
  { name: isEnglish ? 'Home' : 'Inicio', item: isEnglish ? '/en' : '/' },
  ...(parent ? [{ name: parent.label, item: parent.href }] : []),
  { name: breadcrumbLabels[pathname] ?? eyebrow, item: pathname }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.item, site.url).toString()
  }))
};
---
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label={isEnglish ? 'Breadcrumbs' : 'Migas de pan'}>
      {breadcrumbItems.map((item, index) =>
        index < breadcrumbItems.length - 1
          ? <><a href={item.item}>{item.name}</a><span aria-hidden="true">·</span></>
          : <span aria-current="page">{item.name}</span>
      )}
    </nav>
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p>{description}</p>
    {(primaryLabel || secondaryLabel) && (
      <div class="hero-actions page-hero-actions">
        {primaryLabel && primaryHref && <a class="btn btn-dark" href={primaryHref} data-track="primary_cta_click">{primaryLabel}</a>}
        {secondaryLabel && secondaryHref && <a class="btn btn-outline" href={secondaryHref} data-track="secondary_cta_click">{secondaryLabel}</a>}
      </div>
    )}
    {note && <p class="hero-note-light">{note}</p>}
  </div>
  {!isWorkersDev && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
</section>
