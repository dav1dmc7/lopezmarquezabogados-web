---
import '../styles/global.css';
import { site, localizedPathMap } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical = site.url + Astro.url.pathname, noindex = false } = Astro.props;
const canonicalUrl = canonical.replace(/\/$/, '') || site.url;
const pageTitle = title.includes('López Márquez') ? title : `${title} | López Márquez Abogados`;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isEnglish = pathname.startsWith('/en');
const pageLang = isEnglish ? 'en' : 'es';
const hasLocalizedAlternate = Boolean(localizedPathMap[pathname]);
const languageHref = localizedPathMap[pathname] || (isEnglish ? '/' : '/en');
const xDefaultHref = hasLocalizedAlternate
  ? (isEnglish ? new URL(languageHref, site.url).toString() : canonicalUrl)
  : site.url;
const languageLabel = isEnglish ? 'Español' : 'English';
const languageAria = isEnglish
  ? (hasLocalizedAlternate ? 'Ver la versión en español de esta página' : 'Ver la página principal en español')
  : (hasLocalizedAlternate ? 'View the English version of this page' : 'View the English home page');
const isWorkersDev = Astro.url.hostname.endsWith('.workers.dev');
const effectiveNoindex = noindex || isWorkersDev;
const isNavActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LegalService', 'LocalBusiness'],
  '@id': `${site.url}#legal-service`,
  name: site.name,
  url: site.url,
  description: isEnglish ? site.descriptionEn : site.description,
  telephone: site.phone,
  email: site.email,
  image: `${site.url}/og-image.png`,
  logo: `${site.url}/brand/logo.svg`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country
  },
  areaServed: [
    { '@type': 'City', name: 'Barcelona' },
    { '@type': 'AdministrativeArea', name: 'Catalonia' },
    { '@type': 'Country', name: isEnglish ? 'Spain' : 'España' }
  ],
  knowsAbout: isEnglish
    ? ['Employment law', 'Dismissal', 'Immigration law', 'Spanish nationality', 'Employment advice for companies']
    : ['Derecho laboral', 'Despidos laborales', 'Extranjería', 'Nacionalidad española por residencia', 'Asesoramiento laboral a empresas'],
  sameAs: [site.instagram],
  hasMap: site.maps,
  serviceType: isEnglish
    ? ['Employment law', 'Immigration law', 'Employment advice for companies']
    : ['Derecho Laboral', 'Extranjería', 'Asesoramiento laboral a empresas'],
  availableLanguage: ['es', 'en'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: isEnglish ? 'English-speaking enquiries' : 'Consultas jurídicas',
    telephone: site.phone,
    email: site.email,
    availableLanguage: ['es', 'en']
  }
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}#website`,
  name: site.name,
  url: site.url,
  inLanguage: pageLang,
  publisher: { '@id': `${site.url}#legal-service` }
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageTitle,
  description,
  inLanguage: pageLang,
  isPartOf: { '@id': `${site.url}#website` },
  about: { '@id': `${site.url}#legal-service` }
};
---
<html lang={pageLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={effectiveNoindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#15261f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={isEnglish ? 'en_GB' : 'es_ES'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og-image.png`} />
    <title>{pageTitle}</title>
    {!effectiveNoindex && hasLocalizedAlternate && <>
      <link rel="alternate" hreflang="es" href={isEnglish ? new URL(languageHref, site.url).toString() : canonicalUrl} />
      <link rel="alternate" hreflang="en" href={isEnglish ? canonicalUrl : new URL(languageHref, site.url).toString()} />
      <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    </>}
    {!effectiveNoindex && <>
      <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    </>}
    <slot name="head" />
<script src="/analytics.js" defer></script>
</head>
  <body>
    <div class="lm-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">{isEnglish ? 'Skip to content' : 'Ir al contenido'}</a>
    <div class="site-shell">
      <div class="scroll-progress" aria-hidden="true"></div>
      <header class="site-header">
        <div class="container nav-wrap">
          <a class="brand" href={isEnglish ? '/en' : '/'} aria-label={isEnglish ? `${site.name} — home` : `${site.name} — inicio`} data-track="logo_click"><img class="brand-logo" src="/brand/logo.svg" width="168" height="48" alt={site.name} decoding="async" /></a>
          <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label={isEnglish ? 'Open menu' : 'Abrir menú'}>{isEnglish ? 'Menu' : 'Menú'}</button>
          <nav id="main-nav" class="main-nav" aria-label={isEnglish ? 'Primary navigation' : 'Navegación principal'}>
            {isEnglish ? (
              <>
                <a href="/en/immigration" aria-current={isNavActive('/en/immigration') ? 'page' : undefined}>Immigration</a>
                <a href="/en/employment" aria-current={isNavActive('/en/employment') ? 'page' : undefined}>Employment</a>
                <a href="/en/business" aria-current={isNavActive('/en/business') ? 'page' : undefined}>Business</a>
                <a href="/en/about" aria-current={isNavActive('/en/about') ? 'page' : undefined}>About</a>
                <a href="/en/resources" aria-current={isNavActive('/en/resources') ? 'page' : undefined}>Resources</a>
                <a href="/en/contact" aria-current={isNavActive('/en/contact') ? 'page' : undefined}>Contact</a>
              </>
            ) : (
              <>
                <a href="/laboral" aria-current={isNavActive('/laboral') ? 'page' : undefined}>Laboral</a>
                <a href="/extranjeria" aria-current={isNavActive('/extranjeria') ? 'page' : undefined}>Extranjería</a>
                <a href="/empresas" aria-current={isNavActive('/empresas') ? 'page' : undefined}>Empresas</a>
                <a href="/otras-areas" aria-current={isNavActive('/otras-areas') ? 'page' : undefined}>Otras áreas</a>
                <a href="/recursos" aria-current={isNavActive('/recursos') ? 'page' : undefined}>Recursos</a>
                <a href="/actualidad-juridica" aria-current={isNavActive('/actualidad-juridica') ? 'page' : undefined}>Actualidad</a>
                <a href="/sobre-nosotros" aria-current={isNavActive('/sobre-nosotros') ? 'page' : undefined}>Despacho</a>
              </>
            )}
            <a class="language-switch" href={languageHref} aria-label={languageAria} data-track="language_switch_click">{languageLabel}</a>
            <a href={isEnglish ? '/en/contact' : '/contacto'} data-track="primary_cta_click" class="nav-cta">{isEnglish ? 'Contact the firm' : 'Enviar consulta'}</a>
          </nav>
        </div>
      </header>

      <main id="contenido"><slot /></main>

      <footer class="site-footer">
        <div class="container footer-grid">
          <div>
            <img class="footer-logo" src="/brand/logo.svg" width="170" height="60" alt="" aria-hidden="true" loading="lazy" decoding="async" />
            <p class="footer-note">{isEnglish ? 'Employment · Immigration · Business · Barcelona' : 'Derecho Laboral · Extranjería · Empresas · Barcelona'}</p>
          </div>
          <div>
            <p class="footer-label">{isEnglish ? 'Office' : 'Despacho'}</p>
            <a href={site.maps} target="_blank" rel="noopener noreferrer" data-track="maps_click">
              {site.address.street}<br />{site.address.postalCode} {site.address.locality}, Spain
            </a>
            <a href={site.phoneHref} data-track="phone_click">{site.phone}</a>
            <a href={site.emailHref} data-track="email_click">{site.email}</a>
            <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click">{isEnglish ? 'WhatsApp the firm' : 'Escribir por WhatsApp'}</a>
          </div>
          <div>
            <p class="footer-label">{isEnglish ? 'Main services' : 'Principales servicios'}</p>
            {(isEnglish ? site.areasEn : site.areas).map((area) => <a href={area.href}>{area.title}</a>)}
            <a href={isEnglish ? '/en/faqs' : '/preguntas-frecuentes'}>{isEnglish ? 'FAQs' : 'Preguntas frecuentes'}</a>
            <a href={isEnglish ? '/en/resources' : '/recursos'}>{isEnglish ? 'Resources' : 'Recursos'}</a>
            <a href={isEnglish ? '/en/legal-updates' : '/actualidad-juridica'}>{isEnglish ? 'Legal updates' : 'Actualidad jurídica'}</a>
            <a href={isEnglish ? '/en/contact' : '/contacto'}>{isEnglish ? 'Contact' : 'Contacto'}</a>
          </div>
        </div>
        <div class="container footer-bottom">
          <span>© {new Date().getFullYear()} {site.name}</span>
          <span class="footer-legal-links">
            <a href={isEnglish ? '/en/legal-notice' : '/aviso-legal'}>{isEnglish ? 'Legal notice' : 'Aviso legal'}</a>
            <a href={isEnglish ? '/en/privacy' : '/privacidad'}>{isEnglish ? 'Privacy' : 'Privacidad'}</a>
            <a href={isEnglish ? '/en/cookies' : '/cookies'}>{isEnglish ? 'Cookies' : 'Cookies'}</a>
          </span>
        </div>
      </footer>

      <a class="floating-contact" href={site.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={isEnglish ? 'Message López Márquez Abogados on WhatsApp' : 'Escribir por WhatsApp a López Márquez Abogados'} data-track="whatsapp_click">{isEnglish ? 'WhatsApp us' : 'WhatsApp'}</a>
    </div>
      <div class="mobile-conversion-bar" role="group" aria-label={isEnglish ? 'Quick contact' : 'Contacto rápido'}>
  <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-track="mobile_whatsapp">WhatsApp</a>
  <a href={site.phoneHref} data-track="mobile_phone">{isEnglish ? 'Call' : 'Llamar'}</a>
  <a class="primary" href={isEnglish ? '/en/contact' : '/contacto'} data-track="mobile_primary_cta">{isEnglish ? 'Contact' : 'Consultar'}</a>
</div>

    <script src="/site.js" defer></script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "f6d617066f68494b9cb6908f20ba6764"}'></script>
</body>
</html>
