---
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical = site.url + Astro.url.pathname, noindex = false } = Astro.props;
const canonicalUrl = canonical.replace(/\/$/, '') || site.url;
const pageTitle = title.includes('López Márquez') ? title : `${title} | López Márquez Abogados`;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isWorkersDev = Astro.url.hostname.endsWith('.workers.dev');
const effectiveNoindex = noindex || isWorkersDev;
const isNavActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LegalService', 'LocalBusiness'],
  '@id': `${site.url}#legal-service`,
  name: site.name,
  url: site.url,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  image: `${site.url}/og-image.png`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country
  },
  areaServed: 'España',
  knowsAbout: [
    'Derecho laboral',
    'Despidos laborales',
    'Extranjería',
    'Nacionalidad española por residencia',
    'Asesoramiento laboral a empresas'
  ],
  sameAs: [site.instagram],
  hasMap: site.maps,
  serviceType: ['Derecho Laboral', 'Extranjería', 'Asesoramiento laboral a empresas'],
  availableLanguage: ['es']
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}#website`,
  name: site.name,
  url: site.url,
  inLanguage: 'es-ES',
  publisher: { '@id': `${site.url}#legal-service` }
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageTitle,
  description,
  inLanguage: 'es-ES',
  isPartOf: { '@id': `${site.url}#website` },
  about: { '@id': `${site.url}#legal-service` }
};
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={effectiveNoindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#15261f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og-image.png`} />
    <title>{pageTitle}</title>
    {!effectiveNoindex && <>
      <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    </>}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="container nav-wrap">
          <a class="brand" href="/" aria-label={site.name} data-track="logo_click">
            <span class="brand-text"><strong>LÓPEZ MÁRQUEZ</strong><em>ABOGADOS</em></span>
          </a>
          <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir menú">Menú</button>
          <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
            <a href="/laboral" aria-current={isNavActive('/laboral') ? 'page' : undefined}>Laboral</a>
            <a href="/extranjeria" aria-current={isNavActive('/extranjeria') ? 'page' : undefined}>Extranjería</a>
            <a href="/empresas" aria-current={isNavActive('/empresas') ? 'page' : undefined}>Empresas</a>
            <a href="/recursos" aria-current={isNavActive('/recursos') ? 'page' : undefined}>Recursos</a>
            <a href="/actualidad-juridica" aria-current={isNavActive('/actualidad-juridica') ? 'page' : undefined}>Actualidad</a>
            <a href="/sobre-nosotros" aria-current={isNavActive('/sobre-nosotros') ? 'page' : undefined}>Despacho</a>
            <a href={site.emailHref} data-track="email_click" class="nav-cta">Enviar consulta</a>
          </nav>
        </div>
      </header>

      <main id="contenido"><slot /></main>

      <footer class="site-footer">
        <div class="container footer-grid">
          <div>
            <div class="footer-brand">LÓPEZ MÁRQUEZ<br /><span>ABOGADOS</span></div>
            <p class="footer-note">Derecho Laboral · Extranjería · Empresas</p>
          </div>
          <div>
            <p class="footer-label">Despacho</p>
            <a href={site.maps} target="_blank" rel="noopener noreferrer" data-track="maps_click">
              {site.address.street}<br />{site.address.postalCode} {site.address.locality}
            </a>
            <a href={site.phoneHref} data-track="phone_click">{site.phone}</a>
            <a href={site.emailHref} data-track="email_click">{site.email}</a>
          </div>
          <div>
            <p class="footer-label">Principales servicios</p>
            {site.areas.map((area) => <a href={area.href}>{area.title}</a>)}
            <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
            <a href="/otras-areas">Otras áreas jurídicas</a>
            <a href="/contacto">Contacto</a>
          </div>
        </div>
        <div class="container footer-bottom">
          <span>© {new Date().getFullYear()} {site.name}</span>
          <span class="footer-legal-links">
            <a href="/aviso-legal">Aviso legal</a>
            <a href="/privacidad">Privacidad</a>
            <a href="/cookies">Cookies</a>
          </span>
        </div>
      </footer>

      <a class="floating-contact" href={site.emailHref} aria-label="Enviar un email al despacho" data-track="email_click">
        Enviar email
      </a>
    </div>

    <script src="/site.js" defer></script>
  </body>
</html>
